AddDefaultCharset UTF-8


# Skryte soubory a slozky (.git, .github, .gitignore, ...) nikdy neposilat ven.
# Deploy je uz nenahrava (viz .github/workflows/deploy-ftp.yml), tohle je
# pojistka, ktera plati okamzite a nezavisle na tom, co na serveru uz lezi.
# Vyjimka /.well-known/ kvuli obnove certifikatu.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(?!well-known/)"
</IfModule>
# Bezpe?nostní hlavi?ky
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Lehká cache pro statická aktiva
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresDefault "access plus 1 hour"
</IfModule>
