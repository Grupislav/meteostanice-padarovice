AddDefaultCharset UTF-8


# Skryte soubory a slozky (.git, .github, .gitignore, ...) nikdy neposilat ven.
# Deploy je uz nenahrava (viz .github/workflows/deploy-ftp.yml), tohle je
# pojistka, ktera plati okamzite a nezavisle na tom, co na serveru uz lezi.
# Vyjimka /.well-known/ kvuli obnove certifikatu.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(?!well-known/)"
</IfModule>
# Bezpe?nostní hlavi?ky
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Lehká cache pro statická aktiva
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  # Dynamicky vystup (PHP jde ven jako text/html) se necachuje. Drive tu byl
  # ExpiresDefault "access plus 1 hour", ktery se vztahoval i na nej - stranka
  # pak ukazovala az hodinu stara data a odznak "online" tvrdil, ze sber bezi,
  # i kdyz uz 22 hodin stal.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# CDN pred hostingem se ridi hlavne hlavickou Cache-Control, proto ji u PHP
# nastavujeme jeste explicitne. Tyka se to i /scripts/dbinsert.php, ktery musi
# skutecne probehnout pri kazdem volani, ne vratit zacachovanou odpoved.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
